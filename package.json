{
  "name": "switchboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "seed": "tsx scripts/extract-seed.ts",
    "deploy": "npm run build && wrangler pages deploy dist --project-name switchboard",
    "test:e2e": "node tests/webmcp.e2e.mjs",
    "preview:test": "vite preview --port 4319",
    "video": "node scripts/build-video.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.2.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.2",
    "puppeteer-core": "^25.9.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
